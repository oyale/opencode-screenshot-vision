{
  "name": "opencode-screenshot-vision",
  "version": "2.0.0",
  "description": "OpenCode plugin: let a text-only LLM read browser screenshots via local Ollama with OpenCode Zen fallback.",
  "type": "module",
  "license": "MIT",
  "author": "oyale",
  "main": "./dist/vision.js",
  "exports": {
    ".": {
      "types": "./dist/vision.d.ts",
      "default": "./dist/vision.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "smoke": "bun scripts/smoke-vision.ts"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "vision",
    "screenshot",
    "browser",
    "mcp",
    "ollama",
    "playwright",
    "testing",
    "accessibility"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oyale/opencode-screenshot-vision.git"
  },
  "bugs": {
    "url": "https://github.com/oyale/opencode-screenshot-vision/issues"
  },
  "dependencies": {
    "@opencode/plugin": "^2.1.4"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "bun-types": "latest",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
